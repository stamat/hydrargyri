{
  "name": "hydrargyri",
  "version": "2.2.0",
  "description": "Reactive web components in the light DOM — declarative binds and handlers on markup you already wrote",
  "type": "module",
  "main": "src/scripts/hydrargyri.js",
  "types": "./src/scripts/hydrargyri.d.ts",
  "exports": {
    ".": {
      "types": "./src/scripts/hydrargyri.d.ts",
      "default": "./src/scripts/hydrargyri.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/scripts/hydrargyri.js",
    "src/scripts/hydrargyri.d.ts",
    "dist/hydrargyri.mjs",
    "dist/hydrargyri.mjs.map",
    "dist/hydrargyri.min.mjs"
  ],
  "homepage": "https://stamat.github.io/hydrargyri/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stamat/hydrargyri.git"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "reactive",
    "light-dom",
    "data-binding"
  ],
  "author": "Nikola Stamatovic <@stamat>",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stamat/hydrargyri/issues"
  },
  "scripts": {
    "dev": "poops",
    "build": "poops -b",
    "prepack": "poops -b",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {}
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "code-preview-element": "^3.0.0",
    "eslint": "^10.8.0",
    "hydrargyri-each": "^2.2.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "poops": "^2.5.0",
    "poops-docs-theme": "^4.4.0"
  },
  "dependencies": {
    "book-of-spells": "^1.0.22"
  }
}
